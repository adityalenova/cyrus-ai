# Copy this file to .env (same folder) and fill in real values, then restart the dev server.
# Client ids are public identifiers - safe to store here. NEVER put an OAuth
# client SECRET in this file (or anywhere in this repo); for GitHub the secret
# belongs only in the exchange relay (scripts/github-exchange.worker.mjs).

# ── Google ───────────────────────────────────────────────────────────────────
# Google OAuth 2.0 Web client id (Google Cloud Console → Credentials).
# Enables the real "Google" popup in the sign-in sheet and dashboard.
# Console setup: OAuth client (Web) → Authorized JavaScript origins:
#   http://localhost:5330 (and your production origin).
# Leave empty to keep the demo sign-in flow.
VITE_GOOGLE_CLIENT_ID=

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub OAuth app client id (github.com → Settings → Developer settings →
# OAuth Apps → New OAuth App). Homepage URL: http://localhost:5330
# Authorization callback URL: http://localhost:5330/github-callback.html
# (add your production origin's callback too when you host the site).
# Enables the real "GitHub" popup sign-in (PKCE). Leave empty for the demo flow.
VITE_GITHUB_CLIENT_ID=

# Optional but recommended: URL of the token-exchange relay.
# github.com/login/oauth/access_token sends no CORS headers, so a static site
# cannot finish the exchange in the browser alone. Deploy
# scripts/github-exchange.worker.mjs (Cloudflare Worker, holds the client
# secret as a wrangler secret) and point this at its /exchange URL:
#   e.g. https://cyrus-gh-exchange.<account>.workers.dev/exchange
VITE_GITHUB_EXCHANGE_URL=
